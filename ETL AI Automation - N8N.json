      ],
      "id": "085abe84-42f8-4bba-8070-aa612ad477f6",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "Bmrji1uGueNpmDPo",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item, index) => {\n  try {\n    // 1. Get AI output\n    let raw = item.json.text ?? item.json;\n\n    // 2. Parse JSON string\n    if (typeof raw === \"string\") {\n      raw = raw.trim();\n\n      // Remove Markdown code blocks if present\n      raw = raw\n        .replace(/^```(?:json)?\\s*/i, \"\")\n        .replace(/\\s*```$/, \"\");\n\n      raw = JSON.parse(raw);\n    }\n\n    // 3. Clean and normalize data\n    const email = String(raw.Email ?? \"\").trim().toLowerCase();\n\n    const cleaned = {\n      Student_ID: String(raw.Student_ID ?? \"\").trim(),\n      Name: String(raw.Name ?? \"\").trim(),\n      Email: email,\n      Phone: String(raw.Phone ?? \"\").replace(/\\D/g, \"\"),\n      Course: String(raw.Course ?? \"\").trim(),\n      Fee_Paid: raw.Fee_Paid === true ||\n                String(raw.Fee_Paid).toLowerCase() === \"true\",\n      City: String(raw.City ?? \"\").trim(),\n      Enrolled_Date: String(raw.Enrolled_Date ?? \"\").trim(),\n\n      // 4. Validate email\n      Email_Valid: /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email),\n\n      // 5. Validate phone (10 digits)\n      Phone_Valid: /^\\d{10}$/.test(\n        String(raw.Phone ?? \"\").replace(/\\D/g, \"\")\n      ),\n\n      // 6. Processing status\n      Parse_Status: \"Success\"\n    };\n\n    return { json: cleaned };\n\n  } catch (error) {\n    return {\n      json: {\n        Item_Number: index + 1,\n        Parse_Status: \"Failed\",\n        Error: error.message,\n        Raw_Data: item.json.text ?? item.json\n      }\n    };\n  }\n});\n"
      },
